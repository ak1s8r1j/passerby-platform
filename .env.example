# Copy to .env for local work. Never commit .env.
# On Railway these are service variables.

# --- API ---
NODE_ENV=development
PORT=3000
# Postgres. `npm run db:up` (Docker) or `npm run db:embedded` (no Docker) both serve this address.
DATABASE_URL=postgresql://passerby:passerby@localhost:5432/passerby
# Signs sign-in cookies and scrambles IP addresses. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
# The public address of the site, with https:// in production. Used for canonical links and CORS.
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info

# --- Site ---
SITE_NAME=Passerby
# Show the Sign in / account link in the header? Off hides the link only; /account still works.
ACCOUNT_LINK=false
# Shown on the Rules, Terms and Privacy pages, for questions about bans, privacy or payments.
CONTACT_EMAIL=

# --- Sign in with Google (optional) ---
# Leave both blank to hide the "Continue with Google" button. Set both to switch it on.
# Get them from Google Cloud console > APIs & Services > Credentials (see README: "Sign in with Google").
# In the console, add this exact "Authorized redirect URI":  <PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Video ---
# Set to false to switch video chat off for everyone.
VIDEO_ENABLED=true
# A relay server so video works on strict networks (optional). The username and password are sent to
# every visitor's browser, so use an account made only for this.
TURN_URL=
TURN_USER=
TURN_PASS=

# --- Admin area (at /admin) ---
# The owner's sign-in. With no ADMIN_KEY the admin area is switched off. Use a long random key (12+ characters).
ADMIN_USER=admin
ADMIN_KEY=
# How long data is kept before it is deleted automatically.
EVENT_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=90

# --- Money (optional) ---
STRIPE_SECRET_KEY=

# --- Ads (see README: "Ads") ---
# The one switch: set to false and no ad of any kind is shown.
ADS_ENABLED=true
# Your AdSense publisher ID. Without it no AdSense unit is drawn (and /ads.txt is not served).
ADSENSE_CLIENT=
# AdSense ad unit IDs (numbers), one per place. A place with no ID shows nothing.
ADSENSE_SLOT_PROFILE=
ADSENSE_SLOT_LANDING=
# Sponsor cards for the text chat: a JSON list, for example
# [{"id":"acme","name":"Acme","logo":"/sponsors/acme.png","headline":"Cheaper flights","cta":"See deals","url":"https://acme.example"}]
ADS_SPONSORS=
# "none" hides the "watch an ad" button; "demo" plays a 5 second stand-in so the flow can be tried.
REWARDED_ADS=none
# Seconds between profile banner refreshes (60 or more). 0 means never. AdSense does not allow refreshing.
ADS_REFRESH_SECONDS=0
# Make country and who-to-talk-to Plus features (a rewarded ad unlocks them for 30 minutes). Off: they are free.
PLUS_FILTERS=false
# Plus can be bought. Leave off until payments are connected.
PLUS_CHECKOUT=false
