# Copy to .env for local work. Never commit .env.
# On Railway these are service variables.

# --- API ---
NODE_ENV=development
PORT=3000
# Postgres. `npm run db:up` (Docker) or `npm run db:embedded` (no Docker) both serve this address.
DATABASE_URL=postgresql://passerby:passerby@localhost:5432/passerby
# Signs sign-in cookies and scrambles IP addresses. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
# The public address of the site, with https:// in production. Used for canonical links and CORS.
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info

# --- Admin (used from the first admin feature onward) ---
ADMIN_USER=admin
ADMIN_KEY=

# --- Money (optional) ---
STRIPE_SECRET_KEY=
ADSENSE_CLIENT=
ADSENSE_SLOT=
